{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/inventory",
  "$defs": {
    "inventory": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "packaged_in": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "^[a-zA-Z0-9_./-]+$"
                },
                "minItems": 1,
                "maxItems": 500,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "owner",
              "packaged_in"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,79}$"
                },
                "minItems": 1,
                "maxItems": 500,
                "uniqueItems": true
              },
              "phases": {
                "type": "array",
                "items": {
                  "enum": [
                    "build",
                    "install",
                    "upgrade",
                    "runtime",
                    "operations"
                  ]
                },
                "minItems": 1,
                "maxItems": 500,
                "uniqueItems": true
              },
              "requirement": {
                "enum": [
                  "required",
                  "optional",
                  "conditional"
                ]
              },
              "condition": {
                "type": "string",
                "maxLength": 1200
              },
              "settings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:[A-Z][A-Z0-9_]+|model:[A-Za-z][A-Za-z0-9_]*\\.[a-z][a-z0-9_]*)$"
                },
                "minItems": 0,
                "maxItems": 500,
                "uniqueItems": true
              },
              "connections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "direction": {
                      "enum": [
                        "outbound",
                        "inbound",
                        "browser",
                        "host"
                      ]
                    },
                    "protocol": {
                      "enum": [
                        "http",
                        "https",
                        "tcp",
                        "grpc",
                        "postgresql",
                        "redis",
                        "dns",
                        "ntp",
                        "tls",
                        "oci",
                        "package-registry"
                      ]
                    },
                    "ports": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "minItems": 0,
                      "maxItems": 500,
                      "uniqueItems": true
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "required": [
                    "direction",
                    "protocol",
                    "ports",
                    "detail"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 500,
                "uniqueItems": true
              },
              "local_service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "local_replacement": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "supported",
                      "conditional",
                      "unsupported"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  }
                },
                "required": [
                  "status",
                  "detail"
                ],
                "additionalProperties": false
              },
              "failure_behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "source",
                        "test",
                        "documentation"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "pattern": "^[a-zA-Z0-9_./-]+$"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 500,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "owner",
              "purpose",
              "components",
              "phases",
              "requirement",
              "condition",
              "settings",
              "connections",
              "local_service",
              "local_replacement",
              "failure_behavior",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true
        },
        "baseline_topology": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[a-zA-Z0-9_./-]+$"
              },
              "git_blob": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "required": [
              "path",
              "git_blob"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "source_revision",
        "components",
        "dependencies",
        "baseline_topology"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "kind": {
          "const": "inventory-only"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "^(?!.*(?:://|@|(?:[0-9]{1,3}\\.){3}[0-9]{1,3}))[ -~]+$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dependency": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "state": {
                "enum": [
                  "local",
                  "omitted",
                  "preloaded",
                  "bundled"
                ]
              },
              "service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200,
                "pattern": "^(?!.*(?:://|@|(?:[0-9]{1,3}\\.){3}[0-9]{1,3}))[ -~]+$"
              }
            },
            "required": [
              "dependency",
              "state",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "description",
        "bindings"
      ],
      "additionalProperties": false
    }
  }
}
